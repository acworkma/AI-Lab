<!--
    JWT Validation Policy for Foundry LLM API (Private APIM)
    
    Validates OAuth 2.0 bearer tokens from Entra ID.
    Allows any authenticated user in the tenant by default.
    Restrict to specific client app IDs as needed.
    
    Tenant: MngEnvMCAP818246.onmicrosoft.com (38c1a7b0-f16b-45fd-a528-87d8720e868e)
-->
<policies>
    <inbound>
        <base />
        <!-- Validate JWT token from Entra ID -->
        <validate-azure-ad-token tenant-id="38c1a7b0-f16b-45fd-a528-87d8720e868e"
                                  header-name="Authorization"
                                  failed-validation-httpcode="401"
                                  failed-validation-error-message="Unauthorized. Access token is missing or invalid.">
            <audiences>
                <audience>https://cognitiveservices.azure.com</audience>
            </audiences>
        </validate-azure-ad-token>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
